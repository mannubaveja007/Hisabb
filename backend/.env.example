# Render or local database URL.
# SQLite is fine for a weekend demo; use a hosted database for durable data.
DATABASE_URL=sqlite:///./hisabb.db

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# Ollama must be reachable by the deployed backend.
# Local: http://localhost:11434 | Hosted Ollama: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=hi
